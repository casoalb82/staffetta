# systemd unit for Staffetta. Install as /etc/systemd/system/staffetta.service
#
#   sudo useradd --system --home /var/lib/staffetta --shell /usr/sbin/nologin italink
#   sudo install -m 0755 target/release/staffetta /usr/local/bin/staffetta
#   sudo install -d -o italink -g italink -m 0750 /etc/staffetta
#   sudo install -m 0640 -o root -g italink config.toml /etc/staffetta/config.toml
#
# In config.toml use:  state_dir = "/var/lib/staffetta"
[Unit]
Description=Staffetta - link IRC channels across networks
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=italink
Group=italink
ExecStart=/usr/local/bin/staffetta /etc/staffetta/config.toml
Restart=on-failure
RestartSec=10
StateDirectory=staffetta
StateDirectoryMode=0750

# Hardening: it only needs the network and its own state directory.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
CapabilityBoundingSet=
AmbientCapabilities=

[Install]
WantedBy=multi-user.target
